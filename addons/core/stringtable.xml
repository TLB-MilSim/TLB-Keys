            </Key>
            <Key ID="STR_tlb_keys_core_settings_claim">
                <English>Locking a vehicle</English>
            </Key>
            <Key ID="STR_tlb_keys_core_settings_keys">
                <English>Keys and management</English>
            </Key>
            <Key ID="STR_tlb_keys_core_settings_master">
                <English>Master keys</English>
            </Key>
            <Key ID="STR_tlb_keys_core_settings_fob">
